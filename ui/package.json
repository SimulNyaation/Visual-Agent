{
  "name": "visual-agent-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:colors": "node scripts/lint-colors.mjs",
    "test": "vitest run",
    "e2e": "node --test --test-concurrency=1 --test-timeout=180000 e2e/app.e2e.mjs e2e/files.e2e.mjs e2e/terminal.e2e.mjs e2e/terminal-names.e2e.mjs e2e/documents.e2e.mjs e2e/agent-status.e2e.mjs e2e/layout.e2e.mjs",
    "e2e:mouse": "node --test --test-concurrency=1 --test-timeout=180000 e2e/caption.e2e.mjs e2e/mouse.e2e.mjs e2e/files-real.e2e.mjs e2e/terminal-real.e2e.mjs e2e/layout-real.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
